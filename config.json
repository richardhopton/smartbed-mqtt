{
  "name": "Smartbed MQTT (Keeson-only)",
  "version": "1.1.22",
  "slug": "smartbed-mqtt",
  "description": "A Home Assistant add-on to enable controlling Keeson smart beds.",
  "url": "https://github.com/richardhopton/smartbed-mqtt",
  "startup": "application",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "boot": "auto",
  "services": ["mqtt:need"],
  "host_network": true,
  "options": {
    "mqtt_host": "<auto_detect>",
    "mqtt_port": "<auto_detect>",
    "mqtt_user": "<auto_detect>",
    "mqtt_password": "<auto_detect>",
    "type": "keeson",
    "bleProxies": [
      {
        "host": "bluetooth-proxy.local"
      }
    ],
    "keesonDevices": [
      {
        "name": "KSBT03C000015046",
        "friendlyName": "Keeson Bed"
      }
    ]
  },
  "schema": {
    "mqtt_host": "str",
    "mqtt_port": "str",
    "mqtt_user": "str",
    "mqtt_password": "password",
    "type": "list(keeson)",
    "bleProxies": [
      {
        "host": "str",
        "port": "int(1,65536)?",
        "password": "password?",
        "encryptionKey": "match(^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)$)?",
        "expectedServerName": "str?"
      }
    ],
    "keesonDevices": [
      {
        "name": "str",
        "friendlyName": "str"
      }
    ]
  }
}
